#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "../Lib/inc/kbd_define.h"

/ {
	/* Debug output uses RTT; no DK UART or IEEE 802.15.4 transport is used. */
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
		/delete-property/ zephyr,bt-mon-uart;
		/delete-property/ zephyr,bt-c2h-uart;
		/delete-property/ zephyr,ieee802154;
	};

	aliases {
		keyscan-spi = &spi0;
		kbd-knob = &kbd_knob;

		/*
		 * Original PCB wiring, all active-low (same pins as DK LED nodes):
		 * NumLock=P0.14, CapsLock=P0.13, ScrollLock=P0.15.
		 * P0.16 is reserved for charge indication and is not a HID LED.
		 * Adjust aliases/polarity when targeting a different PCB.
		 */
		kbd-led-numlock = &led1;
		kbd-led-capslock = &led0;
		kbd-led-scrolllock = &led2;
	};

	/* DK button0/button3 share the real encoder's A/B pins. */
	buttons {
		status = "disabled";
	};

	/* PWM LED support would claim the Caps Lock GPIO (P0.13). */
	pwmleds {
		status = "disabled";
	};

	kbd_knob: kbd-knob {
		compatible = "gpio-qdec";
		/* Original BSP: A=P0.11, B=P0.25, externally biased. */
		gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>,
			<&gpio0 25 GPIO_ACTIVE_HIGH>;
		steps-per-period = <KBD_KNOB_STEPS_PER_PERIOD>;
		sample-time-us = <KBD_KNOB_SAMPLE_PERIOD_US>;
		idle-timeout-ms = <100>;
		zephyr,axis = <INPUT_REL_WHEEL>;
	};

	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		label = "HID0";
		protocol-code = "keyboard";
		in-report-size = <64>;
		in-polling-period-us = <KBD_HID_REPORT_POLLING_PERIOD_US>;
		/*
		 * Leave interrupt OUT disabled. Keyboard LED output reports are
		 * handled through the control endpoint SET_REPORT path.
		 */
	};

	zephyr,user {
		/* Original board MOS control: drive P1.05 high before scanning.
		 * Adjust the pin/polarity here for a different board.
		 */
		kbd-power-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		/* Original System OFF wake input: external high wakes the MCU. */
		kbd-wake-gpios = <&gpio1 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		keyscan-load-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		mode-wire-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		mode-ble-gpios = <&gpio1 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		mode-wireless-gpios = <&gpio1 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

/* Disable unused DK peripherals instead of initializing their default pins. */
&uart0 { status = "disabled"; };
&uart1 { status = "disabled"; };

/* I2C0 shares both the hardware instance and P0.26/P0.27 with scanning. */
&i2c0 { status = "disabled"; };
&i2c1 { status = "disabled"; };

/* RGB is still a dummy. Configure SPI1 explicitly when RGB is implemented. */
&spi1 { status = "disabled"; };
&spi2 { status = "disabled"; };
/* DK SPI3 uses P1.13/P1.14/P1.15, overlapping CE# and future RGB wiring. */
&spi3 { status = "disabled"; };

&pwm0 { status = "disabled"; };
&pwm1 { status = "disabled"; };
&pwm2 { status = "disabled"; };
&pwm3 { status = "disabled"; };
&sw_pwm { status = "disabled"; };

/* No DK external flash, analog sampling, NFC, or 802.15.4 application. */
&mx25r64 { status = "disabled"; };
&qspi { status = "disabled"; };
&adc { status = "disabled"; };
&nfct { status = "disabled"; };
&ieee802154 { status = "disabled"; };

/* Charge indication is not implemented; retain only the three HID LEDs. */
&led3 { status = "disabled"; };

&spi0 {
	/* SPIM uses EasyDMA; legacy nordic,nrf-spi does not. */
	compatible = "nordic,nrf-spim";
	status = "okay";
	/* 74HC165 CE#: original SER_APP_SPIM0_SS_PIN = P1.13.
	 * Low enables shifting; high inhibits it. Update here for other boards.
	 * keyscan-spi above selects this controller and its CS index 0.
	 */
	cs-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&kbd_scan_spi0_default>;
	pinctrl-1 = <&kbd_scan_spi0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	/* Original BSP wiring: SCK = P0.27, SCAN_OUT (MISO) = P0.26. */
	kbd_scan_spi0_default: kbd_scan_spi0_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 27)>,
				<NRF_PSEL(SPIM_MISO, 0, 26)>;
		};
	};

	kbd_scan_spi0_sleep: kbd_scan_spi0_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 27)>,
				<NRF_PSEL(SPIM_MISO, 0, 26)>;
			low-power-enable;
		};
	};
};
